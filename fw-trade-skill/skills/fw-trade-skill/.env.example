# Shipped with the package as a reference. The real file is ~/.workbuddy/star-wealth-openapi/fosun.env， outside the skill (Windows: %USERPROFILE%\.workbuddy\star-wealth-openapi\fosun.env).
# Never fill this in by hand: fosun-env-setup/code/ensure_fosun_env.py creates and repairs fosun.env.
# It generates the client key pair on this machine and writes the file (mode 600) only after verification.
#
# Variables the script writes
FSOPENAPI_BASE_URL=https://openapi.fosunxcz.com
#FSOPENAPI_API_KEY=
#FSOPENAPI_CLIENT_PRIVATE_KEY=
#FSOPENAPI_SERVER_PUBLIC_KEY=
#FSOPENAPI_ACCOUNT_INDEX=
#
# Optional overrides
#FOSUN_ENV_PATH=
#FSOPENAPI_VERIFY_TLS=
#FSOPENAPI_CA_BUNDLE=
